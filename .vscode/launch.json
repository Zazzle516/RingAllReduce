{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RingAllReduce 图形模拟器",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/AllReduce/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "RingAllReduce 命令行逐事件运行",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/AllReduce/main.py",
      "args": [
        "--cli",
        "--step"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "RingAllGather 图形模拟器",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/AllGather/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "RingAllGather 命令行运行",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/AllGather/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--cli"
      ]
    }
  ]
}
